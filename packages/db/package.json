{
  "name": "@openellie/db",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle ORM schema, client, and migrations for OpenEllie",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "db:generate": "node --require tsx/cjs node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:studio": "node --require tsx/cjs node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@openellie/shared": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@openellie/tsconfig": "workspace:*",
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
