# =============================================================================
# OpenEllie — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# =============================================================================
# SLACK
# =============================================================================

# Bot User OAuth Token (starts with xoxb-)
# In Slack App settings: OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Signing Secret for verifying Slack requests
# In Slack App settings: Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret-here

# App-Level Token for Socket Mode (starts with xapp-)
# In Slack App settings: Basic Information → App-Level Tokens → Generate Token
# Required scopes: connections:write
SLACK_APP_TOKEN=xapp-your-app-token-here

# Your Slack Team/Workspace ID (starts with T)
# Find it in your Slack workspace URL or via the Slack API
SLACK_TEAM_ID=T0123456789

# Optional: Display name for your workspace (used in logs only)
# SLACK_TEAM_NAME=My Engineering Team

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL 17 with pgvector 0.8 extension
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://openellie:openellie@localhost:5432/openellie

# =============================================================================
# REDIS
# =============================================================================

# Redis 7.4 URL
REDIS_URL=redis://localhost:6379

# =============================================================================
# ENCRYPTION
# =============================================================================

# 32-byte hex string used as master encryption key (AES-256-GCM)
# Generate with: openssl rand -hex 32
# NEVER commit this value. Rotate carefully — changing this invalidates all stored credentials.
ENCRYPTION_MASTER_KEY=your-32-byte-hex-key-here-replace-me

# =============================================================================
# GITHUB CONNECTOR
# =============================================================================

# GitHub Personal Access Token
# Required scopes: repo (or public_repo for public repos only), read:user, read:org
# Create at: https://github.com/settings/tokens
GITHUB_PAT=ghp_your-personal-access-token-here

# Comma-separated list of repositories to sync (format: owner/repo)
# Example: GITHUB_REPOS=myorg/api-service,myorg/frontend,myorg/infra
GITHUB_REPOS=myorg/your-repo

# =============================================================================
# AI PROVIDER
# =============================================================================

# Active AI provider: 'openai' | 'anthropic' | 'groq' | 'ollama' | 'custom'
AI_PROVIDER=openai

# OpenAI API Key (if AI_PROVIDER=openai or as fallback for embeddings)
# Create at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# OpenAI model for chat completions
OPENAI_MODEL=gpt-4o

# Anthropic API Key (if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Anthropic model for chat completions
ANTHROPIC_MODEL=claude-opus-4-5-20251101

# Groq API Key (if AI_PROVIDER=groq)
GROQ_API_KEY=gsk_your-groq-key-here

# Groq model for chat completions
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama base URL (if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name (if AI_PROVIDER=ollama)
OLLAMA_MODEL=llama3.2

# Custom OpenAI-compatible base URL (if AI_PROVIDER=custom)
CUSTOM_AI_BASE_URL=

# Custom model name (if AI_PROVIDER=custom)
CUSTOM_AI_MODEL=

# =============================================================================
# EMBEDDING MODEL
# =============================================================================

# Embedding model — must produce 1536-dimensional vectors
# Supported: 'text-embedding-3-small' (OpenAI default) | 'voyage-3-large' (Anthropic/Voyage)
EMBEDDING_MODEL=text-embedding-3-small

# Voyage AI API Key (required if EMBEDDING_MODEL=voyage-3-large)
# Create at: https://www.voyageai.com/
VOYAGE_API_KEY=

# =============================================================================
# BOT API (internal service auth)
# =============================================================================

# Port the Hono HTTP server listens on
BOT_PORT=3000

# Secret for internal API calls from dashboard to bot
# Generate with: openssl rand -hex 32
BOT_API_SECRET=your-internal-api-secret-here

# =============================================================================
# DASHBOARD (Phase 3 — not needed for Phase 1 bot-only deployment)
# =============================================================================

# Auth.js secret for session signing
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# Resend API Key for magic link emails
AUTH_RESEND_KEY=re_your-resend-key-here

# Public URL of the dashboard app
NEXT_PUBLIC_APP_URL=http://localhost:3001

# =============================================================================
# SYNC SETTINGS
# =============================================================================

# Sync frequency in hours: 1 | 4 | 12 | 24
SYNC_FREQUENCY_HOURS=4

# Data retention in days: 30 | 60 | 90
DATA_RETENTION_DAYS=90

# =============================================================================
# FEATURE FLAGS
# =============================================================================

ENABLE_POSTHOG_CONNECTOR=false
ENABLE_USAGE_ANALYTICS=false

# =============================================================================
# NODE ENVIRONMENT
# =============================================================================

NODE_ENV=development

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
