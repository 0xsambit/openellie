{
  "name": "@openellie/bot",
  "version": "0.1.0",
  "private": true,
  "description": "OpenEllie Slack bot — Hono HTTP server with Bolt v4 Socket Mode",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --out-dir dist",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.1.6",
    "@ai-sdk/groq": "^1.1.6",
    "@ai-sdk/openai": "^1.1.6",
    "@hono/node-server": "^1.13.0",
    "@linear/sdk": "^27.0.0",
    "@octokit/rest": "^21.1.1",
    "@octokit/graphql": "^8.1.2",
    "@openellie/db": "workspace:*",
    "@openellie/shared": "workspace:*",
    "@sentry/node": "^8.48.0",
    "@slack/bolt": "^4.1.0",
    "@slack/types": "^2.14.0",
    "@slack/web-api": "^7.8.0",
    "ai": "^4.1.27",
    "bullmq": "^5.30.1",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.7.0",
    "ioredis": "^5.3.2",
    "js-tiktoken": "^1.0.16",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@openellie/tsconfig": "workspace:*",
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "^2.1.8",
    "msw": "^2.7.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
